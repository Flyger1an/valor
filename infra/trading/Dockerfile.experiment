# Build only from an already-present, explicitly pinned Valor runtime image.
# The release context contains exactly the three virtual modules and frozen policy.
ARG VALOR_EXPERIMENT_BASE
FROM ${VALOR_EXPERIMENT_BASE}
USER root
COPY --chown=10001:10001 experiment.py experiment_runner.py shadow_sizing.py /app/evolver/trading/
COPY --chown=10001:10001 policy.json /config/experiment-policy.json
RUN mkdir -p /experiment && chown 10001:10001 /experiment
USER 10001:10001
ENTRYPOINT ["python", "-m", "evolver.trading.experiment_runner"]
CMD ["run", "--policy", "/config/experiment-policy.json", "--root", "/experiment", "--source-root", "/runtime", "--stay-running-after-completion"]
