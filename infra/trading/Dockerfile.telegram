ARG VALOR_NOTIFIER_BASE=python:3.11-slim
FROM ${VALOR_NOTIFIER_BASE}
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY evolver/evolver/trading/telegram_alerts.py /app/telegram_alerts.py
RUN groupadd --gid 10001 valor && useradd --uid 10001 --gid 10001 --no-create-home valor \
    && mkdir /state && chown 10001:10001 /state
USER 10001:10001
ENTRYPOINT ["python", "/app/telegram_alerts.py"]
