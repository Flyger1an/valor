FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
WORKDIR /app
# No old .env files, research caches, web app dependencies or credentials enter this image.
COPY evolver/evolver/trading /app/evolver/trading
RUN groupadd --gid 10001 valor && useradd --uid 10001 --gid 10001 --no-create-home valor \
    && mkdir -p /runtime/state /runtime/outbox /runtime/inbox /runtime/market /runtime/research /runtime/agents /runtime/news \
    && chown -R 10001:10001 /runtime
USER 10001:10001
ENTRYPOINT ["python", "-m", "evolver.trading"]
CMD ["validate", "--policy", "/config/policy.json"]
